{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Blackbox Evidence Capsule","type":"object","required":["schemaVersion","generatedAt","upstreamSha","frameCount","acceptedFrameCount","rejectedFrameCount","orderedCanonicalFrameHashes","terminalState","replayFingerprint","invariantChecks","completenessLimitations"],"properties":{"schemaVersion":{"const":"blackbox-evidence/v1"},"generatedAt":{"type":"string"},"upstreamSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"frameCount":{"type":"integer","minimum":1},"acceptedFrameCount":{"type":"integer","minimum":0},"rejectedFrameCount":{"type":"integer","minimum":0},"orderedCanonicalFrameHashes":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"terminalState":{"enum":["proposed","accepted","locked","claimed","refunded","cancelled"]},"replayFingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"invariantChecks":{"type":"object"},"completenessLimitations":{"type":"array","items":{"type":"string"}}}}